{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonality",
  "version": "0.1.0",
  "identifier": "app.tonality.tonality",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tonality",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#141414",
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: photo: http://photo.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: photo: http://photo.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Coby Mckinney",
    "copyright": "Copyright © 2026 Coby Mckinney and contributors. Licensed under GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Photography",
    "homepage": "https://github.com/cobysmckinney/tonality",
    "shortDescription": "A RAW photo editor and library",
    "longDescription": "Tonality keeps your photos in one library and develops RAW files on the GPU, with masks found by on-device models, presets and a full edit history, behind an interface that doesn't need a tutorial.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
