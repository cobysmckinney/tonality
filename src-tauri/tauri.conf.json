{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tonality",
  "version": "0.1.0",
  "identifier": "app.tonality.tonality",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tonality",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#141414",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
